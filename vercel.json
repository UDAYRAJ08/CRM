{
  "rewrites": [
    {
      "source": "/api/composio",
      "destination": "https://connect.composio.dev/mcp"
    },
    {
      "source": "/api/resend/:match*",
      "destination": "https://api.resend.com/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
