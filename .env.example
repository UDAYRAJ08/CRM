# ------------------------------------------------------------------------------
# SUPABASE CONNECTION CONFIGURATION
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# ------------------------------------------------------------------------------
# MULTI-AI SYSTEM API KEYS (For Professional Bulk Email & Copy Generation)
# (You can also configure these dynamically in the CRM UI under "AI Keys")
# ------------------------------------------------------------------------------
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...
VITE_OPENAI_API_KEY=sk-proj-...
VITE_GEMINI_API_KEY=AIzaSy...
VITE_GROQ_API_KEY=gsk_...
VITE_DEEPSEEK_API_KEY=sk-...
VITE_OPENROUTER_API_KEY=sk-or-v1-...

# ------------------------------------------------------------------------------
# Server-only (Vercel Secrets / vercel dev) - never prefix these with VITE_ (it would expose them publicly)
# ------------------------------------------------------------------------------
# AZURE_TENANT_ID=your-azure-tenant-id
# AZURE_CLIENT_ID=your-azure-app-client-id
# AZURE_CLIENT_SECRET=your-azure-app-client-secret
# EMAIL_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/email-oauth-callback
# EMAIL_TOKEN_ENC_KEY=base64-of-32-random-bytes
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=Your Name <you@yourdomain.com>

# ------------------------------------------------------------------------------
# LINKEDIN OUTREACH SESSION TOKENS (Dev server / server-side ONLY - never prefix with VITE_,
# anything prefixed VITE_ is bundled into the public JavaScript)
# ------------------------------------------------------------------------------
LINKEDIN_LI_AT=your-linkedin-li_at-cookie
LINKEDIN_JSESSIONID="ajax:your-jsessionid-cookie"
