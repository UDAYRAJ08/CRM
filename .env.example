# ------------------------------------------------------------------------------
# SUPABASE CONNECTION CONFIGURATION
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# ------------------------------------------------------------------------------
# EMAIL PROVIDER CONFIGURATION (Composio / Outlook / Resend)
# ------------------------------------------------------------------------------
VITE_EMAIL_PROVIDER=composio
VITE_COMPOSIO_API_KEY=your-composio-api-key
VITE_RESEND_API_KEY=your-resend-api-key
VITE_RESEND_FROM_EMAIL=Your Name <you@yourdomain.com>

# ------------------------------------------------------------------------------
# LINKEDIN OUTREACH SESSION TOKENS (For Automated Dispatch)
# ------------------------------------------------------------------------------
LINKEDIN_LI_AT=your-linkedin-li_at-cookie
LINKEDIN_JSESSIONID="ajax:your-jsessionid-cookie"
VITE_LINKEDIN_LI_AT=your-linkedin-li_at-cookie
VITE_LINKEDIN_JSESSIONID="ajax:your-jsessionid-cookie"

